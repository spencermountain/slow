{
  "name": "slow",
  "version": "2.1.0",
  "description": "Run work in parallel without going too fast",
  "license": "MIT",
  "repository": "github:spencermountain/slow",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/slow.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/slow.cjs"
      }
    }
  },
  "main": "./builds/slow.cjs",
  "module": "./builds/slow.js",
  "types": "./types/index.d.cts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "test": "tape \"./tests/**/*.test.js\" | tap-dancer",
    "testb": "TESTENV=prod tape \"./tests/**/*.test.js\" | tap-dancer",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "dev": "node ./scratch.js",
    "watch": "node --watch ./scratch.js",
    "build": "rollup -c",
    "lint": "eslint ."
  },
  "files": [
    "builds",
    "CHANGELOG.md",
    "types"
  ],
  "keywords": [
    "async",
    "concurrency",
    "parallelism",
    "rate-limiting"
  ],
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "eslint": "^10.11.0",
    "rollup": "4.63.5",
    "rollup-plugin-filesize-check": "^2.0.1",
    "tap-dancer": "0.4.3",
    "tape": "5.10.2",
    "typescript": "^7.0.2"
  },
  "unpkg": "builds/slow.min.js",
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  }
}
